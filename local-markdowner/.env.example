# Server Configuration
PORT=3000

# Security (Optional)
# Set this to bypass rate limiting for trusted clients
# Usage: Authorization: Bearer <token>
BACKEND_SECURITY_TOKEN=

# Node Environment
NODE_ENV=production

# Puppeteer Configuration (Optional)
# Use system-installed Chromium instead of downloading
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
